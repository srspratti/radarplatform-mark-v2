# ============ Radar Hub (plateforme / platform) ============
# FR · vide = ouvert (dev). Prod : exigé via X-Radar-Key
# EN · empty = open (dev). Prod: required via X-Radar-Key
RADAR_API_KEY=
RADAR_TENANT_ID=danny
RADAR_DB_URL=sqlite:///./radar_hub.db
# FR · concierge Vitrine + prévisions + fallbacks Haiku
# EN · Vitrine concierge + forecasts + Haiku fallbacks
ANTHROPIC_API_KEY=
RADAR_HAIKU_MODEL=claude-haiku-4-5-20251001
# FR · Follow Up Boss — import leads + writeback notes
# EN · Follow Up Boss — lead import + note writeback
FUB_API_KEY=
# FR · GoHighLevel — jeton « Private Integration » (pit-…) + id du sous-compte
# EN · GoHighLevel — "Private Integration" token (pit-…) + sub-account (location) id
GHL_API_KEY=
GHL_LOCATION_ID=
# FR · Bonus SMS: avec GHL_* configuré et sans TWILIO_*, les SMS sortants passent
#      par LC Phone (Twilio revendu dans l'abonnement GHL). Prérequis côté GHL:
#      un numéro (Settings → Phone Numbers) + scopes Conversations/Messages sur
#      le jeton. La voix (appels IA) reste Twilio-seulement (pas de TwiML via GHL).
# EN · SMS bonus: with GHL_* set and no TWILIO_*, outbound SMS ride LC Phone
#      (Twilio resold inside the GHL subscription). GHL-side prerequisites:
#      a number (Settings → Phone Numbers) + Conversations/Messages scopes on
#      the token. Voice (AI calls) stays Twilio-only (no TwiML through GHL).

# --- Flux DDF® de l'ACI/CREA / CREA DDF® feed --------------------------------
# FR · Enrichissement licencié par nº MLS/Centris. Demande du courtier sur
#      crea.ca (DDF® → pool national, destination « outil de membre »).
#      Vide = dormant; les PDF détaillés restent le chemin d'enrichissement.
# EN · Licensed enrichment by MLS/Centris number. The broker applies at
#      crea.ca (DDF® → national shared pool, destination "member tool").
#      Empty = dormant; detailed PDFs remain the enrichment path.
DDF_CLIENT_ID=
DDF_CLIENT_SECRET=

# --- Source.immo (ID-3) — distributeur certifié Centris / certified distributor
# FR · Le courtier signe l'autorisation de distribution de données Centris via
#      source.immo → compte + clé API (Immo Distribution API). Vide = dormant.
#      Se compose avec le DDF® : les inscriptions déjà enrichies sont sautées.
# EN · The broker signs the Centris data-distribution authorization through
#      source.immo → account + API key (Immo Distribution API). Empty = dormant.
#      Composes with DDF®: already-enriched listings are skipped.
SOURCEIMMO_ACCOUNT_ID=
SOURCEIMMO_API_KEY=
# FR · HMAC des webhooks portail (vide = dev) / EN · portal-webhook HMAC (empty = dev)
VITRINE_WEBHOOK_SECRET=
RADAR_HALF_LIFE_DAYS=7
RADAR_DORMANT_DAYS=14
# FR · marketable = ToS-safe seulement (courriels + PDF exportés à la main).
#      internal   = en plus, l'outillage RPA de internal/ (compte du courtier,
#                   tests personnels, dry-run par défaut — jamais dans Docker).
# EN · marketable = ToS-safe only (emails + hand-exported PDFs).
#      internal   = additionally, the RPA tooling in internal/ (broker's own
#                   account, personal testing, dry-run default — never in Docker).
RADAR_EDITION=marketable

# --- Adresse d'alerte par client / per-client intake address ------------------
# FR · conçue à la volée, à la conversion / EN · minted on the fly at conversion
# plus: user+tag@gmail.com | alias: tag@domaine (catch-all domain)
INTAKE_EMAIL_MODE=plus
INTAKE_EMAIL_USER=alertes.radar@gmail.com
INTAKE_EMAIL_DOMAIN=inbox.radar.example

# ============ SMS / voix — agents IA / SMS & voice — AI agents (Twilio) ========
# FR · vide = tout part en « simulated » (démo sans risque)
# EN · empty = everything goes out as "simulated" (risk-free demo)
TWILIO_SID=
TWILIO_TOKEN=
# FR · numéro Twilio (SMS sortants + appels vocaux IA)
# EN · the Twilio number (outbound SMS + AI voice calls)
TWILIO_FROM=

# ============ Voix clonée du courtier / broker's cloned voice (ElevenLabs) =====
# FR · vide = <Say> fr-CA/en-CA (voix de synthèse Twilio)
# EN · empty = <Say> fr-CA/en-CA (Twilio synthetic voice)
ELEVENLABS_API_KEY=
# FR · l'ID de la voix clonée du courtier / EN · the broker's cloned-voice ID
ELEVENLABS_VOICE_ID=

# ============ Courriel sortant / outbound email (alert_mailer) =================
# FR · vide = courriels marqués « simulated » / EN · empty = emails marked "simulated"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# FR · URL publique — liens traqués (/l/…), formulaire /q/…, sondage /fb/…, audio TwiML
# EN · Public URL — tracked links (/l/…), /q/… form, /fb/… survey, TwiML audio
RADAR_PUBLIC_URL=http://localhost:8000

# ============ Matrix (hub, ingestion courriel ToS-safe / ToS-safe email ingestion)
MATRIX_IMAP_HOST=
MATRIX_IMAP_USER=
MATRIX_IMAP_PASS=
MATRIX_IMAP_FOLDER=INBOX

# ============ Radar Acheteur (module monté à /acheteur / mounted at /acheteur) =
# FR · partagé: package acheteur + pont hub / EN · shared: buyer package + hub bridge
DB_PATH=./radar_acheteur.db
# FR · boîte des alertes Matrix (voir docs/radar-acheteur)
# EN · the Matrix alerts inbox (see docs/radar-acheteur)
IMAP_HOST=imap.gmail.com
IMAP_USER=
IMAP_PASS=

# ============ Phase 2 — système de génération de leads / lead-gen slot =========
# FR · Le futur système se branche via POST /api/leads (source=own_generated)
#      ou un connecteur dédié — voir README « Slot Phase 2 ».
# EN · The future system plugs in via POST /api/leads (source=own_generated)
#      or a dedicated connector — see README "Phase 2 slot".
